# Niche Society Website .htaccess
# Apache Configuration

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Force HTTPS (uncomment if you have SSL certificate)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Prevent access to sensitive files
    <FilesMatch "^(config\.php|database\.php|\.env|\.git|composer\.(json|lock))$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    
    # Allow POST requests to contact-handler.php (important for form submissions)
    <Files "contact-handler.php">
        # Ensure POST requests are allowed
        <LimitExcept POST>
            Order allow,deny
            Deny from all
        </LimitExcept>
    </Files>
    
    # Protect RSS Aggregator (from .htaccess-rss-protection template)
    <Files "rss-feed-aggregator.php">
        Order Deny,Allow
        Deny from all
        Allow from 127.0.0.1
        Allow from ::1
    </Files>
</IfModule>

# PHP Settings
<IfModule mod_php.c>
    # Increase upload limits if needed
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Content Type Options
    Header always set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Custom Error Pages (optional)
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php
